package templates

import (
	"strconv"
	"time"

	"github.com/Damione1/thread-art-generator/client/internal/auth"
)

// Icon renders one of the inline SVG icons used across the interface.
// Stroke-based, 24px grid, so they scale and recolour with the surrounding text.
templ Icon(name string, class string) {
	<svg class={ "shrink-0 " + class } width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		switch name {
			case "arrow-left":
				<path d="M19 12H6M11 6l-5 6 5 6"></path>
			case "arrow-right":
				<path d="M5 12h13M13 6l6 6-6 6"></path>
			case "chevron-down":
				<path d="M6 9l6 6 6-6"></path>
			case "chevron-left":
				<path d="M15 6l-6 6 6 6"></path>
			case "plus":
				<path d="M12 5v14M5 12h14"></path>
			case "close":
				<path d="M6 6l12 12M18 6L6 18"></path>
			case "search":
				<circle cx="11" cy="11" r="7"></circle>
				<path d="M20 20l-4-4"></path>
			case "upload":
				<path d="M12 16V4M8 8l4-4 4 4"></path>
				<path d="M4 15v4a1 1 0 001 1h14a1 1 0 001-1v-4"></path>
			case "download":
				<path d="M12 3v12M8 11l4 4 4-4"></path>
				<path d="M4 17v3h16v-3"></path>
			case "check-circle":
				<circle cx="12" cy="12" r="9"></circle>
				<path d="M8.5 12.4l2.4 2.4 4.6-5"></path>
			case "alert-circle":
				<circle cx="12" cy="12" r="9"></circle>
				<path d="M12 7.5v5.5"></path>
				<circle cx="12" cy="16.4" r=".7" fill="currentColor" stroke="none"></circle>
			case "info":
				<circle cx="12" cy="12" r="9"></circle>
				<path d="M12 11v5.5"></path>
				<circle cx="12" cy="8" r=".7" fill="currentColor" stroke="none"></circle>
			case "file-text":
				<path d="M6 3h8l4 4v14H6z"></path>
				<path d="M9 12h6M9 16h6"></path>
			case "image":
				<rect x="4" y="5" width="16" height="14" rx="2"></rect>
				<circle cx="9" cy="10" r="1.4"></circle>
				<path d="M5 17l5-5 4 4 3-2 2 3"></path>
			case "mail":
				<rect x="3" y="6" width="18" height="13" rx="2"></rect>
				<path d="M3.5 7.5L12 13l8.5-5.5"></path>
			case "trash":
				<path d="M4 7h16M10 7V5h4v2M6 7l1 13h10l1-13"></path>
			case "copy":
				<rect x="9" y="9" width="11" height="11" rx="2"></rect>
				<path d="M15 6H6a2 2 0 00-2 2v9"></path>
			case "eye":
				<path d="M2.5 12S6 6 12 6s9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6z"></path>
				<circle cx="12" cy="12" r="2.6"></circle>
			case "zoom-in":
				<circle cx="11" cy="11" r="7"></circle>
				<path d="M8 11h6M11 8v6M20 20l-4-4"></path>
			case "zoom-out":
				<circle cx="11" cy="11" r="7"></circle>
				<path d="M8 11h6M20 20l-4-4"></path>
			case "lock":
				<rect x="5" y="11" width="14" height="9" rx="2"></rect>
				<path d="M8 11V8a4 4 0 018 0v3"></path>
			case "user":
				<circle cx="12" cy="8" r="3.4"></circle>
				<path d="M5 20c1.2-4 4-5.6 7-5.6s5.8 1.6 7 5.6"></path>
			case "grid":
				<rect x="4" y="4" width="7" height="7" rx="1.6"></rect>
				<rect x="13" y="4" width="7" height="7" rx="1.6"></rect>
				<rect x="4" y="13" width="7" height="7" rx="1.6"></rect>
				<rect x="13" y="13" width="7" height="7" rx="1.6"></rect>
			case "sort":
				<path d="M7 4v16M7 20l-3-3M17 20V4M17 4l3 3"></path>
			case "hoop":
				<circle cx="12" cy="12" r="8.5"></circle>
				<path d="M5 9l14 6"></path>
			case "spinner":
				<circle cx="12" cy="12" r="9" stroke-opacity=".25"></circle>
				<path d="M21 12a9 9 0 00-9-9"></path>
			default:
				<circle cx="12" cy="12" r="9"></circle>
		}
	</svg>
}

// MaterialIcon maps the legacy Material Symbol names onto the SVG icon set.
// Kept so no page renders a missing glyph; prefer Icon in new markup.
templ MaterialIcon(iconName string, customClasses string) {
	switch iconName {
		case "arrow_back":
			@Icon("arrow-left", customClasses)
		case "add":
			@Icon("plus", customClasses)
		case "check_circle":
			@Icon("check-circle", customClasses)
		case "error", "warning":
			@Icon("alert-circle", customClasses)
		case "pending_actions":
			@Icon("info", customClasses)
		case "refresh":
			@Icon("spinner", customClasses)
		case "description":
			@Icon("file-text", customClasses)
		case "download":
			@Icon("download", customClasses)
		case "image", "inventory_2":
			@Icon("image", customClasses)
		case "visibility":
			@Icon("eye", customClasses)
		case "content_copy":
			@Icon("copy", customClasses)
		case "delete":
			@Icon("trash", customClasses)
		case "close":
			@Icon("close", customClasses)
		case "upload":
			@Icon("upload", customClasses)
		case "zoom_in":
			@Icon("zoom-in", customClasses)
		case "zoom_out":
			@Icon("zoom-out", customClasses)
		case "lock":
			@Icon("lock", customClasses)
		case "expand_more":
			@Icon("chevron-down", customClasses)
		case "sort":
			@Icon("sort", customClasses)
		default:
			@Icon("info", customClasses)
	}
}

// Spinner renders the brass loading ring.
templ Spinner(class string) {
	@Icon("spinner", "animate-spin "+class)
}

// Logo renders the wordmark: a hoop of nails with a few chords across it.
templ Logo(withText bool) {
	<span class="inline-flex items-center gap-2.5 text-[15px] font-semibold tracking-[-0.01em] text-ink">
		<svg width="20" height="20" viewBox="0 0 100 100" aria-hidden="true">
			<circle cx="50" cy="50" r="47" fill="none" stroke="#C79A4B" stroke-width="4.5" stroke-dasharray="1.5 8" stroke-linecap="round"></circle>
			<path d="M12 32 L88 68 M12 68 L74 22 M28 88 L88 40 M50 3 L20 82" stroke="#F4F4F5" stroke-width="2" fill="none" opacity=".75"></path>
		</svg>
		if withText {
			threadart
		}
	</span>
}

// NailRing draws the ring of nails around a disc. Used as an overlay on
// every circular preview so the hoop is always legible.
templ NailRing(class string) {
	<svg class={ "absolute inset-0 w-full h-full pointer-events-none " + class } viewBox="0 0 1000 1000" aria-hidden="true">
		<circle cx="500" cy="500" r="492" fill="none" stroke="#C79A4B" stroke-width="7" stroke-dasharray="1.8 9" stroke-linecap="round" opacity=".55"></circle>
	</svg>
}

// ProgressRing draws an arc around a disc: the share of the render that is done.
// percent is clamped to 0-100.
templ ProgressRing(percent int, class string) {
	{{ p := percent }}
	{{ if p < 0 { p = 0 } }}
	{{ if p > 100 { p = 100 } }}
	{{ circumference := 3091.0 }}
	{{ drawn := circumference * float64(p) / 100.0 }}
	<svg class={ "absolute inset-0 w-full h-full pointer-events-none " + class } viewBox="0 0 1000 1000" aria-hidden="true">
		<circle cx="500" cy="500" r="492" fill="none" stroke="#26262A" stroke-width="7"></circle>
		<circle
			cx="500"
			cy="500"
			r="492"
			fill="none"
			stroke="#C79A4B"
			stroke-width="7"
			stroke-linecap="round"
			stroke-dasharray={ strconv.FormatFloat(drawn, 'f', 1, 64) + " " + strconv.FormatFloat(circumference, 'f', 1, 64) }
			transform="rotate(-90 500 500)"
		></circle>
	</svg>
}

// ErrorAlert renders a list of form-level errors.
templ ErrorAlert(errors []string) {
	if len(errors) > 0 {
		<div class="note note-error mb-5" role="alert">
			@Icon("alert-circle", "w-[15px] h-[15px] mt-px")
			<div>
				if len(errors) == 1 {
					{ errors[0] }
				} else {
					<ul class="list-disc pl-4 space-y-1">
						for _, err := range errors {
							<li>{ err }</li>
						}
					</ul>
				}
			</div>
		</div>
	}
}

// SuccessAlert renders a confirmation message.
templ SuccessAlert(message string) {
	if message != "" {
		<div class="note note-ok mb-5">
			@Icon("check-circle", "w-[15px] h-[15px] mt-px")
			<span>{ message }</span>
		</div>
	}
}

// InfoAlert renders a neutral note.
templ InfoAlert(message string) {
	if message != "" {
		<div class="note mb-5">
			@Icon("info", "w-[15px] h-[15px] mt-px")
			<span>{ message }</span>
		</div>
	}
}

templ Header(isLoggedIn bool, user *auth.UserInfo) {
	<header class="sticky top-0 z-50 h-16 border-b border-line bg-ground/90 backdrop-blur-xl">
		<div class="h-full w-full max-w-[1320px] mx-auto px-6 sm:px-10 lg:px-[60px] flex items-center justify-between gap-8">
			<div class="flex items-center gap-9">
				<a href="/" aria-label="threadart home">
					@Logo(true)
				</a>
				@Navigation(isLoggedIn)
			</div>
			<div class="flex items-center gap-3">
				if !isLoggedIn {
					@AuthLinks()
				} else {
					<a href="/dashboard/arts/new" class="btn btn-sm hidden sm:inline-flex">New project</a>
					@UserMenu(user)
				}
			</div>
		</div>
	</header>
}

templ Navigation(isLoggedIn bool) {
	<nav class="hidden md:flex items-center gap-1">
		if isLoggedIn {
			<a href="/dashboard" class="px-3 py-[7px] rounded-full text-[13.5px] text-ink-muted hover:text-ink hover:bg-surface-raised transition-colors">Projects</a>
		} else {
			<a href="/#how" class="px-3 py-[7px] rounded-full text-[13.5px] text-ink-muted hover:text-ink hover:bg-surface-raised transition-colors">How it works</a>
			<a href="/#compositions" class="px-3 py-[7px] rounded-full text-[13.5px] text-ink-muted hover:text-ink hover:bg-surface-raised transition-colors">Compositions</a>
			<a href="/#exports" class="px-3 py-[7px] rounded-full text-[13.5px] text-ink-muted hover:text-ink hover:bg-surface-raised transition-colors">Exports</a>
		}
	</nav>
}

templ AuthLinks() {
	<a href="/login" class="btn btn-ghost btn-sm">Log in</a>
	<a href="/signup" class="btn btn-primary btn-sm">Start a piece</a>
}

templ UserMenu(user *auth.UserInfo) {
	<div class="relative" x-data="{ open: false }" @click.outside="open = false">
		<button
			type="button"
			class="flex items-center gap-2 pl-3 pr-2 h-9 rounded-full border border-line hover:border-line-strong transition-colors"
			@click="open = !open"
			:aria-expanded="open"
			aria-haspopup="true"
		>
			<span class="hidden sm:inline text-[13px] text-ink-muted">{ SafeUserDisplayName(user) }</span>
			<span class="w-[26px] h-[26px] rounded-full bg-surface-high border border-line-strong flex items-center justify-center text-[11px] font-semibold text-ink-muted overflow-hidden">
				if user != nil && user.Picture != "" {
					<img src={ user.Picture } alt="" class="w-full h-full object-cover"/>
				} else {
					{ SafeUserInitials(user) }
				}
			</span>
		</button>
		<div
			x-show="open"
			x-cloak
			x-transition.opacity.duration.150ms
			class="absolute right-0 mt-2 w-52 card overflow-hidden py-1.5 z-50"
		>
			<a href="/dashboard" class="block px-4 py-2 text-[13px] text-ink-muted hover:bg-surface-raised hover:text-ink">Projects</a>
			<a href="/settings" class="block px-4 py-2 text-[13px] text-ink-muted hover:bg-surface-raised hover:text-ink">Account</a>
			<div class="my-1.5 border-t border-line"></div>
			<a href="#" onclick="logout(); return false;" class="block px-4 py-2 text-[13px] text-danger hover:bg-danger/10">Sign out</a>
		</div>
	</div>
}

templ Footer() {
	<footer class="mt-auto border-t border-line">
		<div class="w-full max-w-[1320px] mx-auto px-6 sm:px-10 lg:px-[60px] py-11 flex flex-col md:flex-row justify-between gap-10">
			<div>
				@Logo(true)
				<p class="hint mt-3.5 max-w-[260px]">Circular thread art from your own photographs. MIT licensed.</p>
			</div>
			<div class="flex gap-16">
				<div>
					<h3 class="font-mono text-[10.5px] tracking-[0.14em] uppercase text-ink-faint">Product</h3>
					<ul class="mt-3.5 space-y-2.5">
						<li><a href="/#how" class="text-[13px] text-ink-muted hover:text-ink">How it works</a></li>
						<li><a href="/#compositions" class="text-[13px] text-ink-muted hover:text-ink">Compositions</a></li>
						<li><a href="/#exports" class="text-[13px] text-ink-muted hover:text-ink">Exports</a></li>
					</ul>
				</div>
				<div>
					<h3 class="font-mono text-[10.5px] tracking-[0.14em] uppercase text-ink-faint">Build</h3>
					<ul class="mt-3.5 space-y-2.5">
						<li><a href="https://github.com/Damione1/thread-art-generator" class="text-[13px] text-ink-muted hover:text-ink">Source on GitHub</a></li>
						<li><a href="https://github.com/bdring/StringArt" class="text-[13px] text-ink-muted hover:text-ink">Hardware &amp; FluidNC</a></li>
					</ul>
				</div>
			</div>
		</div>
		<div class="w-full max-w-[1320px] mx-auto px-6 sm:px-10 lg:px-[60px] pb-10">
			<p class="hint">© { strconv.Itoa(time.Now().Year()) } threadart</p>
		</div>
	</footer>
}
