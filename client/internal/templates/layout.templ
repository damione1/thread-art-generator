package templates

// Layout provides the base page structure with auth-aware navigation
// Uses the PageData view model pattern for consistent data handling
templ Layout(data *PageData) {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ data.GetPageTitle() }</title>
			<script src="/static/js/vendors.js"></script>
			<script src="/static/js/main.js" defer></script>
			if data.PageType == "art" || data.PageType == "composition" {
				<script src="/static/js/rpc.js"></script>
				<script src="/static/js/status-poll.js"></script>
			}
			if data.PageType == "art" {
				<script src="/static/js/art-upload.js"></script>
			}
			if data.PageType == "login" || data.PageType == "signup" || data.PageType == "forgot" || data.PageType == "reset" || data.PageType == "check-email" {
				<script src="/static/js/password-auth.js"></script>
			}
			<meta name="referrer" content="no-referrer"/>
			<meta name="csrf-token" id="csrf-token" content={ CSRFToken(ctx) }/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&amp;family=Instrument+Serif&amp;family=JetBrains+Mono:wght@400;500&amp;display=swap" rel="stylesheet" referrerpolicy="no-referrer"/>
			<link rel="stylesheet" href="/static/css/tailwind.css"/>
			<link rel="stylesheet" href="/static/css/main.css"/>
		</head>
		<body class="min-h-screen flex flex-col bg-ground text-ink">
			@Header(data.IsLoggedIn, data.User)
			<main class="flex-grow w-full">
				{ children... }
			</main>
			@Footer()
		</body>
	</html>
}

// BareLayout renders a page without the application chrome, for the
// split-screen authentication screens.
templ BareLayout(data *PageData) {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ data.GetPageTitle() }</title>
			<script src="/static/js/vendors.js"></script>
			<script src="/static/js/main.js" defer></script>
			<script src="/static/js/password-auth.js"></script>
			<meta name="referrer" content="no-referrer"/>
			<meta name="csrf-token" id="csrf-token" content={ CSRFToken(ctx) }/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&amp;family=Instrument+Serif&amp;family=JetBrains+Mono:wght@400;500&amp;display=swap" rel="stylesheet" referrerpolicy="no-referrer"/>
			<link rel="stylesheet" href="/static/css/tailwind.css"/>
			<link rel="stylesheet" href="/static/css/main.css"/>
		</head>
		<body class="min-h-screen bg-ground text-ink">
			{ children... }
		</body>
	</html>
}

// Shell wraps page content in the standard centred column.
templ Shell() {
	<div class="w-full max-w-[1320px] mx-auto px-6 sm:px-10 lg:px-[60px]">
		{ children... }
	</div>
}
