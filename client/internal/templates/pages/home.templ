package pages

import "github.com/Damione1/thread-art-generator/client/internal/templates"

// HomePage renders the public landing page.
// Uses the PageData view model pattern for consistent data handling.
templ HomePage(data *templates.PageData) {
	@templates.Layout(data) {
		@templates.Shell() {
			@heroSection(data.IsLoggedIn)
			@howSection()
			@compositionsSection()
			@exportsSection()
			@gallerySection()
			@closingSection(data.IsLoggedIn)
		}
	}
}

// primaryCTA is the auth-aware call to action shared by the hero and the
// closing section: signed-out visitors are sent to sign up, signed-in
// visitors are sent back to their projects.
templ primaryCTA(isLoggedIn bool, class string) {
	if isLoggedIn {
		<a href="/dashboard" class={ "btn btn-primary " + class }>Go to your projects</a>
	} else {
		<a href="/signup" class={ "btn btn-primary " + class }>Start a piece</a>
	}
}

templ heroSection(isLoggedIn bool) {
	<section class="grid grid-cols-1 lg:grid-cols-[1fr_560px] gap-16 lg:gap-[88px] items-center py-16 lg:py-[92px] lg:pb-[100px]">
		<div>
			<div class="kicker">Open source · Self-hosted · MIT</div>
			<h1 class="display mt-[26px] text-[42px] sm:text-[58px] lg:text-[76px] leading-[1.02] tracking-[-0.02em] text-ink">
				One photograph,<br/>
				one <em class="italic text-brass">continuous</em><br/>
				thread.
			</h1>
			<p class="mt-6 max-w-[470px] text-[17px] leading-[1.62] text-ink-muted">
				Upload an image, frame it in the hoop, and let the solver find the order of nails
				that redraws it in thread. Compare settings side by side, then export G-code for
				your machine or a numbered path list for your hands.
			</p>
			<div class="flex gap-3 mt-9">
				@primaryCTA(isLoggedIn, "btn-lg")
				<a href="/#compositions" class="btn btn-lg">See a worked example</a>
			</div>
			<div class="flex gap-8 mt-11 pt-[26px] border-t border-line">
				<div>
					<div class="font-mono tabular text-[22px] text-ink">2 412 m</div>
					<div class="text-ink-faint text-xs mt-1">thread in this piece</div>
				</div>
				<div>
					<div class="font-mono tabular text-[22px] text-ink">3 148</div>
					<div class="text-ink-faint text-xs mt-1">nail-to-nail lines</div>
				</div>
				<div>
					<div class="font-mono tabular text-[22px] text-ink">610 mm</div>
					<div class="text-ink-faint text-xs mt-1">hoop radius</div>
				</div>
			</div>
		</div>
		<div class="relative">
			<div class="disc">
				<img src="/static/images/thread-moon.svg" alt="Thread path rendering of a moon photograph strung across 450 nails"/>
				@templates.NailRing("")
			</div>
			<div class="hidden lg:flex absolute items-center gap-[9px] font-mono text-[11.5px] text-ink-muted whitespace-nowrap" style="top:6%;right:-58px">
				<i class="block w-[22px] h-px bg-line-strong"></i>450 nails
			</div>
			<div class="hidden lg:flex absolute items-center gap-[9px] font-mono text-[11.5px] text-ink-muted whitespace-nowrap" style="bottom:13%;left:-70px">
				min. gap 18<i class="block w-[22px] h-px bg-line-strong"></i>
			</div>
		</div>
	</section>
}

templ howSection() {
	<section id="how" class="border-t border-line py-16 lg:py-[88px]">
		<div class="max-w-[620px]">
			<div class="kicker">The flow</div>
			<h2 class="display mt-[18px] text-[32px] sm:text-[42px] leading-[1.1] tracking-[-0.01em] text-ink">Three steps, and the hoop does the rest.</h2>
		</div>
		<div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-[52px]">
			<div>
				<div class="w-full aspect-[1.35] rounded-2xl border border-line bg-surface flex items-center justify-center mb-[22px]">
					<svg width="150" height="150" viewBox="0 0 100 100">
						<rect x="14" y="22" width="72" height="56" rx="4" fill="none" stroke="#33333A" stroke-width="1.4"></rect>
						<path d="M14 62 L34 44 L50 58 L64 48 L86 66" fill="none" stroke="#33333A" stroke-width="1.4"></path>
						<circle cx="50" cy="50" r="30" fill="none" stroke="#C79A4B" stroke-width="1.6"></circle>
						<circle cx="50" cy="50" r="30" fill="none" stroke="#C79A4B" stroke-width="4" stroke-dasharray=".8 6" stroke-linecap="round" opacity=".55"></circle>
					</svg>
				</div>
				<div class="font-mono text-[11px] text-brass tracking-[0.14em]">01</div>
				<h3 class="text-[19px] font-semibold tracking-[-0.01em] mt-[14px] text-ink">Upload and frame</h3>
				<p class="text-ink-muted text-sm leading-[1.6] mt-[9px]">Thread art is round, so framing is part of the work. Pan and zoom your photo inside the hoop mask until the crop is right.</p>
			</div>
			<div>
				<div class="w-full aspect-[1.35] rounded-2xl border border-line bg-surface flex items-center justify-center mb-[22px]">
					<svg width="150" height="150" viewBox="0 0 100 100">
						<circle cx="50" cy="34" r="24" fill="none" stroke="#C79A4B" stroke-width="3.4" stroke-dasharray=".8 5" stroke-linecap="round" opacity=".6"></circle>
						<path d="M28 26 L70 44 M32 46 L66 22 M28 40 L64 48 M38 15 L60 52" stroke="#EDEDEE" stroke-width=".9" opacity=".5" fill="none"></path>
						<rect x="18" y="70" width="64" height="2" rx="1" fill="#26262A"></rect>
						<rect x="18" y="70" width="38" height="2" rx="1" fill="#C79A4B"></rect>
						<circle cx="56" cy="71" r="4" fill="#EFE6D4"></circle>
						<rect x="18" y="86" width="64" height="2" rx="1" fill="#26262A"></rect>
						<rect x="18" y="86" width="22" height="2" rx="1" fill="#C79A4B"></rect>
						<circle cx="40" cy="87" r="4" fill="#EFE6D4"></circle>
					</svg>
				</div>
				<div class="font-mono text-[11px] text-brass tracking-[0.14em]">02</div>
				<h3 class="text-[19px] font-semibold tracking-[-0.01em] mt-[14px] text-ink">Tune the composition</h3>
				<p class="text-ink-muted text-sm leading-[1.6] mt-[9px]">Nail count, path budget, contrast, minimum gap. Every run is kept, so you can queue three settings and compare the results.</p>
			</div>
			<div>
				<div class="w-full aspect-[1.35] rounded-2xl border border-line bg-surface flex items-center justify-center mb-[22px]">
					<svg width="150" height="150" viewBox="0 0 100 100">
						<path d="M50 18 L50 62 M36 48 L50 62 L64 48" fill="none" stroke="#C79A4B" stroke-width="2" stroke-linecap="round"></path>
						<path d="M22 70 L22 82 L78 82 L78 70" fill="none" stroke="#33333A" stroke-width="1.6" stroke-linecap="round"></path>
						<text x="50" y="14" text-anchor="middle" fill="#6B6B74" font-family="ui-monospace,monospace" font-size="7">G1 X41.2 Y88.0</text>
					</svg>
				</div>
				<div class="font-mono text-[11px] text-brass tracking-[0.14em]">03</div>
				<h3 class="text-[19px] font-semibold tracking-[-0.01em] mt-[14px] text-ink">Export and string it</h3>
				<p class="text-ink-muted text-sm leading-[1.6] mt-[9px]">Download G-code for a FluidNC winder, or the numbered path list to string the hoop by hand. Thread length is calculated for you.</p>
			</div>
		</div>
	</section>
}

templ compositionsSection() {
	<section id="compositions" class="border-t border-line py-16 lg:py-[88px]">
		<div class="flex flex-col md:flex-row md:justify-between md:items-end gap-8 md:gap-10">
			<div class="max-w-[560px]">
				<div class="kicker">Compositions</div>
				<h2 class="display mt-[18px] text-[32px] sm:text-[42px] leading-[1.1] tracking-[-0.01em] text-ink">Same photo. Three sets of numbers.</h2>
				<p class="mt-5 text-[17px] leading-[1.62] text-ink-muted">Nail count and path budget change the piece more than the photo does. Runs sit side by side in the project so you can pick with your eyes, not with a guess.</p>
			</div>
		</div>
		<div class="grid grid-cols-1 md:grid-cols-3 gap-7 mt-[52px]">
			<figure class="m-0">
				<div class="disc">
					<img src="/static/images/thread-moon-180.svg" alt="Thread path rendering of a moon photograph strung across 180 nails, the sparsest of the three runs"/>
					<svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 1000 1000" aria-hidden="true">
						<circle cx="500" cy="500" r="492" fill="none" stroke="#C79A4B" stroke-width="7" stroke-dasharray="2 18" stroke-linecap="round" opacity=".55"></circle>
					</svg>
				</div>
				<figcaption class="flex justify-between items-baseline mt-4 font-mono text-xs text-ink-muted">
					<span>180 nails · 900 paths</span>
					<span class="text-ink-faint">612 m</span>
				</figcaption>
			</figure>
			<figure class="m-0">
				<div class="disc">
					<img src="/static/images/thread-moon-300.svg" alt="Thread path rendering of the same moon photograph strung across 300 nails, a middle-density run"/>
					<svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 1000 1000" aria-hidden="true">
						<circle cx="500" cy="500" r="492" fill="none" stroke="#C79A4B" stroke-width="7" stroke-dasharray="2 12.5" stroke-linecap="round" opacity=".55"></circle>
					</svg>
				</div>
				<figcaption class="flex justify-between items-baseline mt-4 font-mono text-xs text-ink-muted">
					<span>300 nails · 4 000 paths</span>
					<span class="text-ink-faint">1 380 m</span>
				</figcaption>
			</figure>
			<figure class="m-0">
				<div class="disc">
					<img src="/static/images/thread-moon.svg" alt="Thread path rendering of the same moon photograph strung across 450 nails, the densest of the three runs"/>
					<svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 1000 1000" aria-hidden="true">
						<circle cx="500" cy="500" r="492" fill="none" stroke="#C79A4B" stroke-width="7" stroke-dasharray="1.6 8" stroke-linecap="round" opacity=".55"></circle>
					</svg>
				</div>
				<figcaption class="flex justify-between items-baseline mt-4 font-mono text-xs text-ink-muted">
					<span>450 nails · 12 000 paths</span>
					<span class="text-ink-faint">2 412 m</span>
				</figcaption>
			</figure>
		</div>
	</section>
}

templ exportsSection() {
	<section id="exports" class="border-t border-line py-16 lg:py-[88px]">
		<div class="max-w-[620px]">
			<div class="kicker">What you get out</div>
			<h2 class="display mt-[18px] text-[32px] sm:text-[42px] leading-[1.1] tracking-[-0.01em] text-ink">Files that end up on a wall.</h2>
		</div>
		<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-px bg-line border border-line rounded-card overflow-hidden mt-[52px]">
			<div class="bg-ground py-[26px] px-6">
				<h3 class="text-sm font-semibold text-ink">G-code</h3>
				<p class="text-[12.5px] text-ink-faint leading-[1.55] mt-[7px]">Coordinates for a FluidNC winder, scaled to your real hoop radius in millimetres.</p>
			</div>
			<div class="bg-ground py-[26px] px-6">
				<h3 class="text-sm font-semibold text-ink">Path list</h3>
				<p class="text-[12.5px] text-ink-faint leading-[1.55] mt-[7px]">The nail order as plain numbers, for stringing the hoop by hand.</p>
			</div>
			<div class="bg-ground py-[26px] px-6">
				<h3 class="text-sm font-semibold text-ink">Preview PNG</h3>
				<p class="text-[12.5px] text-ink-faint leading-[1.55] mt-[7px]">A render of the finished piece before a single metre of thread is spent.</p>
			</div>
			<div class="bg-ground py-[26px] px-6">
				<h3 class="text-sm font-semibold text-ink">Thread length</h3>
				<p class="text-[12.5px] text-ink-faint leading-[1.55] mt-[7px]">Total metres and line count, so you know what to buy before you start.</p>
			</div>
		</div>
		<p class="hint mt-[22px] max-w-[560px]">Machine designs come from bdring's StringArt project; FluidNC configs ship with the repository.</p>
	</section>
}

templ gallerySection() {
	<section class="border-t border-line py-16 lg:py-[88px]">
		<h2 class="display text-[32px] sm:text-[42px] leading-[1.1] tracking-[-0.01em] text-ink">Made with threadart</h2>
		<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-5 mt-12">
			<div class="disc">
				<img src="/static/images/thread-crescent.svg" alt="Thread art rendering of a crescent moon composition"/>
				@templates.NailRing("")
			</div>
			<div class="disc">
				<img src="/static/images/thread-horizon.svg" alt="Thread art rendering of a horizon composition"/>
				@templates.NailRing("")
			</div>
			<div class="disc">
				<img src="/static/images/thread-spiral.svg" alt="Thread art rendering of a spiral composition"/>
				@templates.NailRing("")
			</div>
			<div class="disc">
				<img src="/static/images/thread-moon-alt.svg" alt="Thread art rendering of an alternate moon study"/>
				@templates.NailRing("")
			</div>
			<div class="disc">
				<img src="/static/images/thread-dunes.svg" alt="Thread art rendering of a dune landscape composition"/>
				@templates.NailRing("")
			</div>
			<div class="disc">
				<img src="/static/images/thread-moon-300.svg" alt="Thread art rendering of a moon study at 300 nails"/>
				@templates.NailRing("")
			</div>
		</div>
	</section>
}

templ closingSection(isLoggedIn bool) {
	<section class="border-t border-line text-center py-16 lg:py-[100px]">
		<h2 class="display text-[38px] sm:text-[52px] leading-[1.1] tracking-[-0.01em] text-ink">Start with one photograph.</h2>
		<p class="mt-5 mx-auto max-w-[520px] text-[17px] leading-[1.62] text-ink-muted text-center">Free while it is in the workshop. Bring your own storage, run it yourself, or use the hosted instance.</p>
		<div class="flex justify-center gap-3 mt-9">
			@primaryCTA(isLoggedIn, "btn-lg")
			<a href="https://github.com/Damione1/thread-art-generator" class="btn btn-lg">Source on GitHub</a>
		</div>
	</section>
}
