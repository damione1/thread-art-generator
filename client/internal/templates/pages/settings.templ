package pages

import "github.com/Damione1/thread-art-generator/client/internal/templates"

templ SettingsPage(data *templates.PageData) {
	@templates.Layout(data) {
		@templates.Shell() {
			<h1 class="display text-[36px] pt-9">Account</h1>
			<div class="grid grid-cols-1 lg:grid-cols-[220px_1fr] gap-8 lg:gap-14 items-start py-8 lg:py-9">
				<nav class="flex gap-1 overflow-x-auto pb-1 lg:flex-col lg:overflow-visible lg:pb-0">
					<a href="#profile" class="block px-3.5 py-2 rounded-[10px] text-[13.5px] whitespace-nowrap bg-surface-raised text-ink">Profile</a>
					<a href="#password" class="block px-3.5 py-2 rounded-[10px] text-[13.5px] whitespace-nowrap text-ink-muted hover:text-ink">Password</a>
				</nav>
				<div class="min-w-0">
					if data.HasError() {
						@templates.ErrorAlert([]string{ data.ErrorMessage })
					}
					if data.GetSettingsData().Saved == "profile" {
						@templates.SuccessAlert("Profile saved.")
					}
					if data.GetSettingsData().Saved == "email" {
						@templates.SuccessAlert("Check your new inbox to confirm the email change.")
					}
					if data.GetSettingsData().Saved == "email-confirmed" {
						@templates.SuccessAlert("Email updated.")
					}
					if data.GetSettingsData().Saved == "password" {
						@templates.SuccessAlert("Password updated.")
					}
					<section id="profile" class="card p-7 scroll-mt-24">
						<h2 class="text-[17px] font-semibold tracking-[-0.01em]">Profile</h2>
						<p class="hint mt-[7px] text-[13px] leading-[1.55]">The name shown on the pieces you publish to the gallery.</p>
						<form method="POST" action="/settings/profile" class="mt-[22px]">
							<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-[18px]">
								<div class="field">
									<label for="first_name" class="label">First name</label>
									<input
										id="first_name"
										name="first_name"
										type="text"
										required
										value={ data.GetSettingsData().FirstName }
										class="input"
									/>
									for _, err := range templates.FieldMsgs(data.GetSettingsData().FieldErrors, "first_name") {
										<p class="msg-error">{ err }</p>
									}
								</div>
								<div class="field">
									<label for="last_name" class="label">Last name</label>
									<input
										id="last_name"
										name="last_name"
										type="text"
										value={ data.GetSettingsData().LastName }
										class="input"
									/>
								</div>
								<div class="field sm:col-span-2">
									<label for="email" class="label">Email</label>
									<input
										id="email"
										name="email"
										type="email"
										required
										value={ data.GetSettingsData().Email }
										class="input"
									/>
									<p class="hint">Changing this sends a confirmation link to the new address. The old one keeps working until you follow it.</p>
									for _, err := range templates.FieldMsgs(data.GetSettingsData().FieldErrors, "email") {
										<p class="msg-error">{ err }</p>
									}
								</div>
							</div>
							<div class="flex justify-end gap-2.5 mt-6 pt-5 border-t border-line">
								<button type="reset" class="btn btn-ghost">Discard</button>
								<button type="submit" class="btn btn-primary">Save profile</button>
							</div>
						</form>
					</section>
					<section id="password" class="card p-7 mt-6 scroll-mt-24">
						<h2 class="text-[17px] font-semibold tracking-[-0.01em]">Password</h2>
						<p class="hint mt-[7px] text-[13px] leading-[1.55]">Choose a new password. You will need your current password to confirm the change.</p>
						<form method="POST" action="/settings/password" class="mt-[22px]">
							<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-[18px]">
								<div class="field sm:col-span-2">
									<label for="current_password" class="label">Current password</label>
									<input
										id="current_password"
										name="current_password"
										type="password"
										required
										autocomplete="current-password"
										class="input"
									/>
									for _, err := range templates.FieldMsgs(data.GetSettingsData().FieldErrors, "current_password") {
										<p class="msg-error">{ err }</p>
									}
								</div>
								<div class="field">
									<label for="new_password" class="label">New password</label>
									<input
										id="new_password"
										name="new_password"
										type="password"
										required
										minlength="8"
										autocomplete="new-password"
										class="input"
									/>
									<p class="hint">At least 8 characters.</p>
									for _, err := range templates.FieldMsgs(data.GetSettingsData().FieldErrors, "new_password") {
										<p class="msg-error">{ err }</p>
									}
								</div>
								<div class="field">
									<label for="confirm_password" class="label">Confirm new password</label>
									<input
										id="confirm_password"
										name="confirm_password"
										type="password"
										required
										minlength="8"
										autocomplete="new-password"
										class="input"
									/>
									for _, err := range templates.FieldMsgs(data.GetSettingsData().FieldErrors, "confirm_password") {
										<p class="msg-error">{ err }</p>
									}
								</div>
							</div>
							<div class="flex justify-end mt-6 pt-5 border-t border-line">
								<button type="submit" class="btn btn-primary">Update password</button>
							</div>
						</form>
					</section>
				</div>
			</div>
		}
	}
}
