package pages

import "github.com/Damione1/thread-art-generator/client/internal/templates"

// authSplit renders the shared split-screen shell used by every
// authentication page: a left panel carrying the thread artwork and a line
// of copy, and a right panel that centers the page's own form content.
// Below lg the left panel is dropped and the form is centered on its own.
templ authSplit(data *templates.PageData) {
	<div class="min-h-screen lg:grid lg:grid-cols-2">
		<div class="hidden lg:flex relative flex-col justify-between overflow-hidden border-r border-line p-11">
			<div
				class="disc absolute -right-[190px] top-1/2 w-[760px] h-[760px] -translate-y-1/2"
				style="background:radial-gradient(circle at 50% 50%,#131316 0%,#0A0A0B 82%)"
			>
				<img src="/static/images/thread-crescent.svg" alt=""/>
				@templates.NailRing("")
			</div>
			<a href="/" class="relative" aria-label="threadart home">
				@templates.Logo(true)
			</a>
			<div class="relative">
				<p class="display text-[26px] leading-[1.35] max-w-[330px]">
					A single thread, wound between four hundred nails, holding a photograph.
				</p>
				<p class="hint mt-[18px] max-w-[330px]">Eclipse study · 450 nails · 2 118 m of cotton thread</p>
			</div>
		</div>
		<div class="flex min-h-screen items-center justify-center px-6 py-11 sm:px-10 lg:min-h-0">
			<div class="w-full max-w-[352px]">
				{ children... }
			</div>
		</div>
	</div>
}

templ LoginPage(data *templates.PageData) {
	@templates.BareLayout(data) {
		@authSplit(data) {
			<h1 class="display text-[32px]">Welcome back</h1>
			<p class="hint mt-2.5 text-[13.5px]">Sign in to your projects and compositions.</p>
			<form id="email-signin-form" method="POST" action="/auth/login" class="flex flex-col gap-[18px] mt-8">
				@templates.CSRFInput()
				<div class="field">
					<label for="email-address" class="label">Email</label>
					<input
						id="email-address"
						name="email"
						type="email"
						autocomplete="email"
						required
						class="input"
						placeholder="you@example.com"
					/>
				</div>
				<div class="field">
					<div class="flex items-baseline justify-between">
						<label for="password" class="label">Password</label>
						<a href="/forgot-password" class="text-brass text-[12.5px]">Forgot your password?</a>
					</div>
					<input
						id="password"
						name="password"
						type="password"
						autocomplete="current-password"
						required
						class="input"
					/>
				</div>
				<button type="submit" class="btn btn-primary btn-block h-[44px] mt-1">
					Sign in
				</button>
			</form>
			<div class="flex items-center gap-3.5 my-[26px] text-ink-faint text-xs">
				<span class="flex-1 h-px bg-line"></span>
				or
				<span class="flex-1 h-px bg-line"></span>
			</div>
			<p class="hint text-center text-[13px]">
				New here? <a href="/signup" class="text-brass">Create an account</a>
			</p>
			<p class="hint text-center text-[11.5px] mt-11">
				By signing in you agree to the terms and the privacy notice.
			</p>
			if data.Meta["error"] != "" {
				<div class="note note-error mt-4">{ data.Meta["error"] }</div>
			}
			if data.Meta["ok"] != "" {
				<div class="note note-ok mt-4">{ data.Meta["ok"] }</div>
			}
			<div id="auth-error" class="hidden note note-error mt-4">
				<p id="auth-error-message"></p>
			</div>
		}
	}
}

templ SignupPage(data *templates.PageData) {
	@templates.BareLayout(data) {
		@authSplit(data) {
			<h1 class="display text-[32px]">Create your account</h1>
			<p class="hint mt-2.5 text-[13.5px]">One account holds your projects, your compositions and your exports.</p>
			<form id="email-signup-form" method="POST" action="/auth/signup" class="flex flex-col gap-[18px] mt-8">
				@templates.CSRFInput()
				<div class="grid grid-cols-2 gap-3.5">
					<div class="field">
						<label for="signup-first-name" class="label">First name</label>
						<input
							id="signup-first-name"
							name="first_name"
							type="text"
							autocomplete="given-name"
							required
							class="input"
						/>
					</div>
					<div class="field">
						<label for="signup-last-name" class="label">Last name</label>
						<input
							id="signup-last-name"
							name="last_name"
							type="text"
							autocomplete="family-name"
							class="input"
							placeholder="Optional"
						/>
					</div>
				</div>
				<div class="field">
					<label for="signup-email" class="label">Email</label>
					<input
						id="signup-email"
						name="email"
						type="email"
						autocomplete="email"
						required
						class="input"
						placeholder="you@example.com"
					/>
				</div>
				<div class="field">
					<label for="signup-password" class="label">Password</label>
					<input
						id="signup-password"
						name="password"
						type="password"
						autocomplete="new-password"
						required
						minlength="8"
						class="input"
					/>
					<p class="hint">At least 8 characters.</p>
				</div>
				<div class="field">
					<label for="signup-confirm-password" class="label">Confirm password</label>
					<input
						id="signup-confirm-password"
						name="confirmPassword"
						type="password"
						autocomplete="new-password"
						required
						minlength="8"
						class="input"
					/>
				</div>
				<button type="submit" class="btn btn-primary btn-block h-[44px] mt-1">
					Create account
				</button>
			</form>
			<p class="hint text-center text-[13px] mt-4">
				Already have one? <a href="/login" class="text-brass">Sign in</a>
			</p>
			<div id="auth-error" class="hidden note note-error mt-4">
				<p id="auth-error-message"></p>
			</div>
		}
	}
}

templ ForgotPasswordPage(data *templates.PageData) {
	@templates.BareLayout(data) {
		@authSplit(data) {
			<h1 class="display text-[32px]">Reset your password</h1>
			<p class="hint mt-2.5 text-[13.5px]">We will email a link if an account exists for that address.</p>
			if data.Meta["sent"] == "1" {
				<div class="note note-ok mt-5">
					If that email exists, we sent a reset link. In local dev, open Mailhog at localhost:8025.
				</div>
			}
			<form id="forgot-password-form" method="POST" action="/auth/forgot-password" class="flex flex-col gap-[18px] mt-8">
				@templates.CSRFInput()
				<div class="field">
					<label for="forgot-email" class="label">Email</label>
					<input
						id="forgot-email"
						name="email"
						type="email"
						autocomplete="email"
						required
						class="input"
						placeholder="you@example.com"
					/>
				</div>
				<button type="submit" class="btn btn-primary btn-block h-[44px]">
					Send the reset link
				</button>
			</form>
			<div id="auth-error" class="hidden note note-error mt-4">
				<p id="auth-error-message"></p>
			</div>
			<div id="auth-success" class="hidden note note-ok mt-4">
				<p id="auth-success-message"></p>
			</div>
			<p class="hint text-center text-[13px] mt-4">
				<a href="/login" class="text-brass">Back to sign in</a>
			</p>
		}
	}
}

templ ResetPasswordPage(data *templates.PageData) {
	@templates.BareLayout(data) {
		@authSplit(data) {
			<h1 class="display text-[32px]">Choose a new password</h1>
			<p class="hint mt-2.5 text-[13.5px]">You followed a reset link, so pick something you have not used here before.</p>
			if data.Meta["error"] != "" {
				<div class="note note-error mt-5">{ data.Meta["error"] }</div>
			}
			<form id="reset-password-form" method="POST" action="/reset-password" class="flex flex-col gap-[18px] mt-8">
				@templates.CSRFInput()
				<input type="hidden" name="token" value={ data.Meta["token"] }/>
				<div class="field">
					<label for="reset-password" class="label">New password</label>
					<input
						id="reset-password"
						name="password"
						type="password"
						autocomplete="new-password"
						required
						minlength="8"
						class="input"
					/>
					<p class="hint">At least 8 characters.</p>
				</div>
				<div class="field">
					<label for="reset-confirm-password" class="label">Confirm new password</label>
					<input
						id="reset-confirm-password"
						name="confirm_password"
						type="password"
						autocomplete="new-password"
						required
						minlength="8"
						class="input"
					/>
				</div>
				<button type="submit" class="btn btn-primary btn-block h-[44px]">
					Update password
				</button>
			</form>
			<div id="auth-error" class="hidden note note-error mt-4">
				<p id="auth-error-message"></p>
			</div>
		}
	}
}

templ CheckEmailPage(data *templates.PageData) {
	@templates.BareLayout(data) {
		@authSplit(data) {
			<div class="flex flex-col items-center text-center">
				<div class="w-[76px] h-[76px] rounded-full border border-dashed border-line-strong flex items-center justify-center">
					@templates.Icon("mail", "w-[26px] h-[26px] text-brass")
				</div>
				<h1 class="display text-[32px] mt-6">Check your email</h1>
				<p class="hint mt-2.5 text-[13.5px]">We sent a confirmation link. Open it to activate your account.</p>
				<p class="hint text-[13.5px]">In local dev, open Mailhog at localhost:8025.</p>
			</div>
			<div class="note mt-6">Nothing after a few minutes? Look in spam, or send it again below.</div>
			if data.Meta["sent"] == "1" {
				<div class="note note-ok mt-4">If that email exists, we sent another confirmation link.</div>
			}
			<form id="resend-verification-form" method="POST" action="/auth/resend-verification" class="flex gap-2.5 mt-4">
				@templates.CSRFInput()
				<input
					name="email"
					type="email"
					autocomplete="email"
					required
					class="input flex-1"
					placeholder="you@example.com"
				/>
				<button type="submit" class="btn">Resend</button>
			</form>
			<div id="auth-error" class="hidden note note-error mt-4">
				<p id="auth-error-message"></p>
			</div>
			<div id="auth-success" class="hidden note note-ok mt-4">
				<p id="auth-success-message"></p>
			</div>
			<p class="hint text-center text-[13px] mt-4">
				<a href="/login" class="text-brass">Back to sign in</a>
			</p>
		}
	}
}
