package pages

import "github.com/Damione1/thread-art-generator/client/internal/templates"

templ LoginPage(data *templates.PageData) {
	@templates.Layout(data) {
		<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
			<div class="max-w-md w-full space-y-8">
				<div>
					<h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900">
						Sign in to your account
					</h2>
					<p class="mt-2 text-center text-sm text-gray-600">
						Or
						<a href="/signup" class="font-medium text-indigo-600 hover:text-indigo-500">
							create a new account
						</a>
					</p>
				</div>
				<form id="email-signin-form" class="mt-8 space-y-6">
					<div class="rounded-md shadow-sm -space-y-px">
						<div>
							<label for="email-address" class="sr-only">Email address</label>
							<input
								id="email-address"
								name="email"
								type="email"
								autocomplete="email"
								required
								class="appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-t-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm"
								placeholder="Email address"
							/>
						</div>
						<div>
							<label for="password" class="sr-only">Password</label>
							<input
								id="password"
								name="password"
								type="password"
								autocomplete="current-password"
								required
								class="appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-b-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm"
								placeholder="Password"
							/>
						</div>
					</div>
					<button
						type="submit"
						class="group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
					>
						Sign in
					</button>
					<p class="text-sm text-center">
						<a href="/forgot-password" class="font-medium text-indigo-600 hover:text-indigo-500">
							Forgot your password?
						</a>
					</p>
				</form>
				<div id="auth-error" class="hidden mt-4 p-4 border border-red-300 rounded-md bg-red-50">
					<p id="auth-error-message" class="text-sm text-red-700"></p>
				</div>
			</div>
		</div>
	}
}

templ SignupPage(data *templates.PageData) {
	@templates.Layout(data) {
		<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
			<div class="max-w-md w-full space-y-8">
				<div>
					<h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900">
						Create your account
					</h2>
					<p class="mt-2 text-center text-sm text-gray-600">
						Or
						<a href="/login" class="font-medium text-indigo-600 hover:text-indigo-500">
							sign in to your existing account
						</a>
					</p>
				</div>
				<form id="email-signup-form" class="mt-8 space-y-6">
					<div class="rounded-md shadow-sm -space-y-px">
						<div>
							<label for="signup-first-name" class="sr-only">First name</label>
							<input
								id="signup-first-name"
								name="first_name"
								type="text"
								autocomplete="given-name"
								required
								class="appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-t-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm"
								placeholder="First name"
							/>
						</div>
						<div>
							<label for="signup-last-name" class="sr-only">Last name</label>
							<input
								id="signup-last-name"
								name="last_name"
								type="text"
								autocomplete="family-name"
								class="appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm"
								placeholder="Last name"
							/>
						</div>
						<div>
							<label for="signup-email" class="sr-only">Email address</label>
							<input
								id="signup-email"
								name="email"
								type="email"
								autocomplete="email"
								required
								class="appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm"
								placeholder="Email address"
							/>
						</div>
						<div>
							<label for="signup-password" class="sr-only">Password</label>
							<input
								id="signup-password"
								name="password"
								type="password"
								autocomplete="new-password"
								required
								minlength="8"
								class="appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm"
								placeholder="Password (min. 8 characters)"
							/>
						</div>
						<div>
							<label for="signup-confirm-password" class="sr-only">Confirm Password</label>
							<input
								id="signup-confirm-password"
								name="confirmPassword"
								type="password"
								autocomplete="new-password"
								required
								minlength="8"
								class="appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-b-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm"
								placeholder="Confirm password"
							/>
						</div>
					</div>
					<button
						type="submit"
						class="group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
					>
						Create account
					</button>
				</form>
				<div id="auth-error" class="hidden mt-4 p-4 border border-red-300 rounded-md bg-red-50">
					<p id="auth-error-message" class="text-sm text-red-700"></p>
				</div>
			</div>
		</div>
	}
}

templ ForgotPasswordPage(data *templates.PageData) {
	@templates.Layout(data) {
		<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
			<div class="max-w-md w-full space-y-8">
				<div>
					<h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900">
						Reset your password
					</h2>
					<p class="mt-2 text-center text-sm text-gray-600">
						We'll email you a reset link if that account exists.
					</p>
				</div>
				if data.Meta["sent"] == "1" {
					<div class="p-4 border border-green-300 rounded-md bg-green-50">
						<p class="text-sm text-green-700">If that email exists, we sent a reset link. In local dev, open Mailhog at localhost:8025.</p>
					</div>
				}
				<form id="forgot-password-form" method="POST" action="/auth/forgot-password" class="mt-8 space-y-6">
					<input
						id="forgot-email"
						name="email"
						type="email"
						autocomplete="email"
						required
						class="appearance-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
						placeholder="Email address"
					/>
					<button
						type="submit"
						class="group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
					>
						Send reset link
					</button>
				</form>
				<div id="auth-error" class="hidden mt-4 p-4 border border-red-300 rounded-md bg-red-50">
					<p id="auth-error-message" class="text-sm text-red-700"></p>
				</div>
				<div id="auth-success" class="hidden mt-4 p-4 border border-green-300 rounded-md bg-green-50">
					<p id="auth-success-message" class="text-sm text-green-700"></p>
				</div>
				<p class="text-sm text-center">
					<a href="/login" class="font-medium text-indigo-600 hover:text-indigo-500">Back to sign in</a>
				</p>
			</div>
		</div>
	}
}

templ ResetPasswordPage(data *templates.PageData) {
	@templates.Layout(data) {
		<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
			<div class="max-w-md w-full space-y-8">
				<div>
					<h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900">
						Choose a new password
					</h2>
				</div>
				<form id="reset-password-form" method="POST" action="/auth/reset-password" class="mt-8 space-y-6">
					<input type="hidden" name="token" value={ data.Meta["token"] }/>
					<div class="rounded-md shadow-sm -space-y-px">
						<input
							id="reset-password"
							name="password"
							type="password"
							autocomplete="new-password"
							required
							minlength="8"
							class="appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-t-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
							placeholder="New password (min. 8 characters)"
						/>
						<input
							id="reset-confirm-password"
							name="confirm_password"
							type="password"
							autocomplete="new-password"
							required
							minlength="8"
							class="appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-b-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
							placeholder="Confirm password"
						/>
					</div>
					<button
						type="submit"
						class="group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
					>
						Update password
					</button>
				</form>
				<div id="auth-error" class="hidden mt-4 p-4 border border-red-300 rounded-md bg-red-50">
					<p id="auth-error-message" class="text-sm text-red-700"></p>
				</div>
			</div>
		</div>
	}
}

templ CheckEmailPage(data *templates.PageData) {
	@templates.Layout(data) {
		<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
			<div class="max-w-md w-full space-y-8 text-center">
				<h2 class="mt-6 text-3xl font-extrabold text-gray-900">Check your email</h2>
				<p class="text-sm text-gray-600">
					We sent a confirmation link. Open it to activate your account.
				</p>
				<p class="text-sm text-gray-500">In local dev, open Mailhog at localhost:8025.</p>
				<form id="resend-verification-form" method="POST" action="/auth/resend-verification" class="space-y-4 text-left">
					<input
						name="email"
						type="email"
						autocomplete="email"
						required
						class="appearance-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
						placeholder="Email address"
					/>
					<button
						type="submit"
						class="w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700"
					>
						Resend confirmation
					</button>
				</form>
				<div id="auth-error" class="hidden mt-4 p-4 border border-red-300 rounded-md bg-red-50">
					<p id="auth-error-message" class="text-sm text-red-700"></p>
				</div>
				<div id="auth-success" class="hidden mt-4 p-4 border border-green-300 rounded-md bg-green-50">
					<p id="auth-success-message" class="text-sm text-green-700"></p>
				</div>
				<p class="text-sm">
					<a href="/login" class="font-medium text-indigo-600 hover:text-indigo-500">Back to sign in</a>
				</p>
			</div>
		</div>
	}
}
