package pages

import (
	"strconv"

	"github.com/Damione1/thread-art-generator/client/internal/templates"
	"github.com/Damione1/thread-art-generator/core/pb"
	"github.com/Damione1/thread-art-generator/core/resource"
)

// extractArtID extracts the art ID from a resource name using the resource parser
func extractArtID(resourceName string) string {
	artResource, err := resource.ParseResourceName(resourceName)
	if err != nil {
		return ""
	}

	art, ok := artResource.(*resource.Art)
	if !ok {
		return ""
	}

	return art.ArtID
}

// projectsKicker renders the small "N projects" count above the page title.
func projectsKicker(n int) string {
	switch n {
	case 0:
		return "No projects"
	case 1:
		return "1 project"
	default:
		return strconv.Itoa(n) + " projects"
	}
}

// countByStatus tallies arts per status for the (non-filtering) status chips.
func countByStatus(arts []*pb.Art) (complete, running, needsImage int) {
	for _, art := range arts {
		switch art.GetStatus() {
		case pb.ArtStatus_ART_STATUS_COMPLETE:
			complete++
		case pb.ArtStatus_ART_STATUS_PROCESSING:
			running++
		case pb.ArtStatus_ART_STATUS_PENDING_IMAGE:
			needsImage++
		}
	}
	return
}

// artCardMeta renders the left-hand meta text on a project card.
func artCardMeta(art *pb.Art) string {
	if art.GetStatus() == pb.ArtStatus_ART_STATUS_PENDING_IMAGE {
		return "No image yet"
	}
	if art.GetCreateTime() != nil {
		return "Created " + art.GetCreateTime().AsTime().Format("Jan 2, 2006")
	}
	return ""
}

// DashboardPage renders the projects listing with sort controls.
// Uses the PageData view model pattern for consistent data handling.
templ DashboardPage(data *templates.PageData) {
	@templates.Layout(data) {
		@templates.Shell() {
			if data.IsLoggedIn {
				{{ arts := data.GetDashboardData().GetArts() }}
				<div class="flex items-end justify-between gap-8 pt-11 pb-6">
					<div>
						<div class="kicker">{ projectsKicker(len(arts)) }</div>
						<h1 class="display text-[38px] leading-none tracking-[-0.01em] mt-3">Projects</h1>
					</div>
					<div class="flex items-center gap-2.5">
						@SortControl(data.GetDashboardData().Dir)
						<a href="/dashboard/arts/new" class="btn btn-primary btn-sm">New project</a>
					</div>
				</div>
				@StatusChips(arts)
				@ArtGrid(arts)
			} else {
				@UnauthenticatedMessage()
			}
		}
	}
}

// SortControl toggles the create_time sort direction. Same two links as
// before; only the presentation changed.
templ SortControl(dir string) {
	if dir == "asc" {
		<a href="/dashboard?sort=create_time&dir=desc" class="btn btn-sm">
			Oldest first
			@templates.Icon("chevron-down", "w-[11px] h-[11px]")
		</a>
	} else {
		<a href="/dashboard?sort=create_time&dir=asc" class="btn btn-sm">
			Newest first
			@templates.Icon("chevron-down", "w-[11px] h-[11px]")
		</a>
	}
}

// StatusChips shows a read-only breakdown of the arts by status.
// There is no server-side filter for these yet, so the chips are plain
// counts rather than links: a link with a `status` query parameter would
// visually invite filtering while the dashboard handler silently ignores it,
// which is more misleading than not having the control.
templ StatusChips(arts []*pb.Art) {
	{{ complete, running, needsImage := countByStatus(arts) }}
	<div class="flex flex-wrap gap-2 pt-1.5 pb-6 border-b border-line">
		<span class="inline-flex items-center gap-1.5 h-[30px] px-3.5 rounded-full border border-line-strong bg-surface-raised text-[12.5px] text-ink">
			All <span class="font-mono text-[11px] text-ink-faint">{ strconv.Itoa(len(arts)) }</span>
		</span>
		<span class="inline-flex items-center gap-1.5 h-[30px] px-3.5 rounded-full border border-line text-[12.5px] text-ink-muted">
			Complete <span class="font-mono text-[11px] text-ink-faint">{ strconv.Itoa(complete) }</span>
		</span>
		<span class="inline-flex items-center gap-1.5 h-[30px] px-3.5 rounded-full border border-line text-[12.5px] text-ink-muted">
			Rendering <span class="font-mono text-[11px] text-ink-faint">{ strconv.Itoa(running) }</span>
		</span>
		<span class="inline-flex items-center gap-1.5 h-[30px] px-3.5 rounded-full border border-line text-[12.5px] text-ink-muted">
			Needs an image <span class="font-mono text-[11px] text-ink-faint">{ strconv.Itoa(needsImage) }</span>
		</span>
	</div>
}

// ArtGrid renders the grid of project discs: the "new project" card first,
// then the user's arts, then the empty state if there are none.
templ ArtGrid(arts []*pb.Art) {
	<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 py-8 pb-16">
		@NewArtCard()
		for _, art := range arts {
			@ArtCard(art)
		}
		if len(arts) == 0 {
			@NoProjectsCard()
		}
	</div>
}

// NewArtCard renders the dashed "start a project" card.
templ NewArtCard() {
	<a href="/dashboard/arts/new" class="border border-dashed border-line-strong rounded-[22px] p-[18px] pb-5 flex flex-col items-center justify-center text-center hover:border-ink-faint transition-colors">
		<div class="w-[76%] aspect-square rounded-full border border-dashed border-line-strong flex items-center justify-center text-brass">
			@templates.Icon("plus", "w-7 h-7")
		</div>
		<h3 class="text-[14.5px] font-semibold tracking-[-0.005em] mt-5">New project</h3>
		<p class="hint mt-1.5 max-w-[180px]">Start from a photograph</p>
	</a>
}

// ArtCard renders one project disc: the image (with its nail ring) when
// there is one, an indeterminate ring while the image is processing, or a
// dashed empty ring while no image has been uploaded yet.
templ ArtCard(art *pb.Art) {
	{{ artID := extractArtID(art.GetName()) }}
	<a href={ templ.URL("/dashboard/arts/" + artID) } class="block bg-surface border border-line rounded-[22px] p-[18px] pb-5 hover:border-line-strong transition-colors">
		<div class="disc">
			if art.GetImageUrl() != "" {
				<img src={ art.GetImageUrl() } alt={ art.GetTitle() }/>
				@templates.NailRing("")
			} else if art.GetStatus() == pb.ArtStatus_ART_STATUS_PROCESSING {
				<svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 1000 1000" aria-hidden="true">
					<circle cx="500" cy="500" r="492" fill="none" stroke="#26262A" stroke-width="7"></circle>
				</svg>
			} else {
				<div class="absolute inset-0 flex items-center justify-center">
					@templates.Icon("upload", "w-8 h-8 text-ink-faint")
				</div>
				<svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 1000 1000" aria-hidden="true">
					<circle cx="500" cy="500" r="492" fill="none" stroke="#33333A" stroke-width="5" stroke-dasharray="14 16"></circle>
				</svg>
			}
		</div>
		<h3 class="text-[14.5px] font-semibold tracking-[-0.005em] mt-[18px] truncate">{ art.GetTitle() }</h3>
		<div class="flex items-center justify-between mt-[9px] gap-2">
			<span class="font-mono text-[11.5px] text-ink-faint truncate">{ artCardMeta(art) }</span>
			@templates.ArtStatusBadge(art.GetStatus())
		</div>
	</a>
}

// NoProjectsCard renders the empty state shown alongside the "new project" card.
templ NoProjectsCard() {
	<div class="border border-dashed border-line-strong rounded-[22px] p-8 flex flex-col items-center justify-center text-center">
		<svg width="64" height="64" viewBox="0 0 100 100" aria-hidden="true">
			<circle cx="50" cy="50" r="44" fill="none" stroke="#33333A" stroke-width="2" stroke-dasharray="6 9"></circle>
			<path d="M50 38v24M38 50h24" stroke="#C79A4B" stroke-width="2" stroke-linecap="round"></path>
		</svg>
		<h3 class="text-[15px] font-semibold mt-4">No projects yet</h3>
		<p class="hint mt-2 max-w-[220px]">A project starts with one photograph. Anything with strong light and a clear subject works best.</p>
		<a href="/dashboard/arts/new" class="btn btn-primary btn-sm mt-4">New project</a>
	</div>
}

// UnauthenticatedMessage renders a message for unauthenticated users
templ UnauthenticatedMessage() {
	<div class="card p-10 my-16 max-w-md mx-auto flex flex-col items-center text-center">
		<div class="w-16 h-16 rounded-full bg-surface-raised flex items-center justify-center mb-4">
			@templates.Icon("lock", "w-7 h-7 text-ink-faint")
		</div>
		<h2 class="text-lg font-semibold mb-3">Account required</h2>
		<p class="hint mb-6">Please log in to access your dashboard and manage your thread art projects.</p>
		<a href="/login" class="btn btn-primary">Log in</a>
	</div>
}
