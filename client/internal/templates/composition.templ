package templates

import (
	"fmt"
	"math"
	"strings"

	"github.com/Damione1/thread-art-generator/core/pb"
	"github.com/Damione1/thread-art-generator/threadGenerator"
)

// CompositionFormData represents the form data for creating compositions
type CompositionFormData struct {
	NailsQuantity     int32   // Default: 280
	ImgSize           int32   // Default: 800
	MaxPaths          int32   // Default: 4500
	StartingNail      int32   // Default: 0
	MinimumDifference int32   // Default: 22
	BrightnessFactor  int32   // Default: 40
	ImageContrast     float32 // Default: 28 (AdjustContrast percent)
	PhysicalRadius    float32 // Default: 304.8 (24-inch hoop diameter)
	Algorithm         pb.CompositionAlgorithm
	Errors            map[string][]string
	Success           bool
}

func algorithmOf(a pb.CompositionAlgorithm) threadGenerator.Algorithm {
	return threadGenerator.Lookup(threadGenerator.Kind(a))
}

func algorithmValue(a pb.CompositionAlgorithm) string {
	return algorithmOf(a).FormValue()
}

func algorithmLabel(a pb.CompositionAlgorithm) string {
	return algorithmOf(a).Label()
}

func solverUsesBrightness(a pb.CompositionAlgorithm) bool {
	return algorithmOf(a).UsesBrightness()
}

func compositionAlpineData(formData *CompositionFormData) string {
	var b strings.Builder
	b.WriteString("{ contrast: ")
	b.WriteString(fmt.Sprint(int(formData.ImageContrast)))
	b.WriteString(", algorithm: '")
	b.WriteString(algorithmValue(formData.Algorithm))
	b.WriteString("', brightness: {")
	for i, algo := range threadGenerator.Algorithms() {
		if i > 0 {
			b.WriteByte(',')
		}
		fmt.Fprintf(&b, "'%s':%t", algo.FormValue(), algo.UsesBrightness())
	}
	b.WriteString("} }")
	return b.String()
}

// nailSpacingMM returns the arc distance between two adjacent nails, in
// millimetres, for the given hoop radius and nail count.
func nailSpacingMM(radius float32, nails int32) float64 {
	if nails <= 0 {
		return 0
	}
	return 2 * math.Pi * float64(radius) / float64(nails)
}

// errClass returns "input-error" when the named field has a validation error.
func errClass(errs map[string][]string, field string) string {
	if HasFieldErr(errs, field) {
		return "input-error"
	}
	return ""
}

func solverContrastCSS(pct float32) string {
	return fmt.Sprintf("--solver-contrast: %.4f", (100+float64(pct))/100)
}

// NewCompositionPage renders the composition creation form
templ NewCompositionPage(data *PageData, art *pb.Art, formData *CompositionFormData) {
	@Layout(data) {
		@Shell() {
			<div class="pt-[34px] flex items-center gap-2.5 text-[12.5px] text-ink-faint">
				<a href="/dashboard" class="hover:text-ink-muted transition-colors">Projects</a>
				<span>/</span>
				<a href={ templ.SafeURL("/dashboard/arts/" + extractArtID(art.GetName())) } class="hover:text-ink-muted transition-colors">{ art.GetTitle() }</a>
				<span>/</span>
				<span class="text-ink-muted">New composition</span>
			</div>
			<h1 class="display text-[36px] leading-[1.05] mt-3.5">New composition</h1>
			<p class="hint mt-2.5 text-[13.5px]">Eight numbers decide what the thread does. Every run is kept, so try more than one.</p>
			@CompositionEditor(art, formData)
		}
	}
}

// CompositionEditor is the photo preview + settings form. HTMX replaces this
// whole block on validation errors so the live contrast preview stays wired.
templ CompositionEditor(art *pb.Art, formData *CompositionFormData) {
	<div
		id="composition-editor"
		class="grid grid-cols-1 lg:grid-cols-[400px_1fr] gap-12 items-start py-[30px] pb-10"
		x-data={ compositionAlpineData(formData) }
	>
		<aside>
			<div
				class="disc disc-photo"
				style={ solverContrastCSS(formData.ImageContrast) }
				x-bind:style="'--solver-contrast:' + ((100 + contrast) / 100)"
			>
				<img src={ art.GetImageUrl() } alt={ art.GetTitle() }/>
				@NailRing("")
			</div>
			<p class="hint mt-2.5 text-center">How the solver reads the hoop · <span class="font-mono text-ink-muted" data-contrast-readout x-text="contrast + '%'"></span> contrast</p>
			<div class="card mt-6 px-[22px] pt-[22px] pb-[18px]">
				<h3 class="text-[13px] font-semibold">The hoop, as configured</h3>
				<svg viewBox="0 0 100 100" class="w-full mt-3.5" aria-hidden="true">
					<circle cx="50" cy="50" r="41" fill="none" stroke="#C79A4B" stroke-width="2.2" stroke-dasharray=".45 2.6" stroke-linecap="round" opacity=".7"></circle>
					<g stroke="#EDEDEE" stroke-opacity=".34" stroke-width=".55" fill="none">
						<path d="M50 9 L18.7 76.5 M50 9 L84.6 71.5 M50 9 L9.5 62 M18.7 76.5 L88 40 M84.6 71.5 L14 33"></path>
					</g>
					<path d="M50 9 A41 41 0 0 1 64.9 12.8" fill="none" stroke="#E0B463" stroke-width="1.1"></path>
					<circle cx="50" cy="9" r="2.4" fill="#E0B463"></circle>
					<circle cx="64.9" cy="12.8" r="1.8" fill="#E0B463" opacity=".65"></circle>
				</svg>
				<div class="mt-2">
					<div class="kv"><span class="kv-k">Nails</span><span class="kv-v">{ fmt.Sprint(formData.NailsQuantity) }</span></div>
					<div class="kv"><span class="kv-k">Hoop radius</span><span class="kv-v">{ fmt.Sprintf("%.1f mm", formData.PhysicalRadius) }</span></div>
					<div class="kv"><span class="kv-k">Spacing between nails</span><span class="kv-v">{ fmt.Sprintf("%.1f mm", nailSpacingMM(formData.PhysicalRadius, formData.NailsQuantity)) }</span></div>
				</div>
			</div>
			<p class="hint mt-3">Rendering runs in the background and takes a few minutes. You can close this page.</p>
		</aside>
		@CompositionForm(art, formData)
	</div>
}

// CompositionForm renders the composition creation form
templ CompositionForm(art *pb.Art, formData *CompositionFormData) {
	<form
		method="POST"
		action={ templ.SafeURL("/dashboard/arts/" + extractArtID(art.GetName()) + "/composition/new") }
		hx-post={ "/dashboard/arts/" + extractArtID(art.GetName()) + "/composition/new" }
		hx-target="#composition-editor"
		hx-swap="outerHTML"
		hx-indicator="#submit-spinner"
		class="card p-0"
	>
		@CSRFInput()
		if len(formData.Errors["_form"]) > 0 {
			<div class="px-[26px] pt-[22px]">
				@ErrorAlert(formData.Errors["_form"])
			</div>
		}
		<div class="px-[26px] pt-[26px] pb-1.5">
			<div class="flex items-baseline gap-3 mb-5">
				<h3 class="text-sm font-semibold">The solver</h3>
				<span class="text-[12.5px] text-ink-faint">How lines are chosen. G-code stays the same.</span>
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pb-6">
				for _, algo := range threadGenerator.Algorithms() {
					<label class="card px-[18px] py-4 cursor-pointer border transition-colors" :class={ "algorithm === '" + algo.FormValue() + "' ? 'border-brass' : 'border-line'" }>
						<input type="radio" name="algorithm" value={ algo.FormValue() } class="sr-only" x-model="algorithm"/>
						<div class="text-[13px] font-semibold">{ algo.Label() }</div>
						<p class="hint mt-1.5">{ algo.Hint() }</p>
					</label>
				}
			</div>
			<div class="flex items-baseline gap-3 mb-5">
				<h3 class="text-sm font-semibold">The hoop</h3>
				<span class="text-[12.5px] text-ink-faint">Physical geometry of the frame</span>
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-x-7 gap-y-[22px] pb-6">
				<!-- Number of nails -->
				<div class="field">
					<label class="label" for="nails_quantity">Number of nails</label>
					<div class="relative">
						<input
							id="nails_quantity"
							type="number"
							name="nails_quantity"
							value={ fmt.Sprint(formData.NailsQuantity) }
							min="1"
							max="1000"
							required
							class={ "input input-num pr-14 " + errClass(formData.Errors, "composition.nails_quantity") }
						/>
						<span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 font-mono text-xs text-ink-faint">nails</span>
					</div>
					<p class="hint">Evenly spaced around the rim. 200–500 is the usual range; more nails means finer detail and a longer render.</p>
					for _, err := range FieldMsgs(formData.Errors, "composition.nails_quantity") {
						<p class="msg-error">{ err }</p>
					}
				</div>
				<!-- Starting nail -->
				<div class="field">
					<label class="label" for="starting_nail">Starting nail</label>
					<input
						id="starting_nail"
						type="number"
						name="starting_nail"
						value={ fmt.Sprint(formData.StartingNail) }
						min="0"
						required
						class={ "input input-num " + errClass(formData.Errors, "composition.starting_nail") }
					/>
					<p class="hint">Nail 0 sits at the top and numbering runs clockwise. Must be less than the nail count.</p>
					for _, err := range FieldMsgs(formData.Errors, "composition.starting_nail") {
						<p class="msg-error">{ err }</p>
					}
				</div>
				<!-- Minimum gap -->
				<div class="field" x-data={ "{v: " + fmt.Sprint(formData.MinimumDifference) + "}" }>
					<label class="label" for="minimum_difference">Minimum gap</label>
					<div class="flex items-baseline justify-between gap-3">
						<span class="hint">Nails skipped before the thread may return</span>
						<span class="font-mono text-[13px] text-ink" x-text="v"></span>
					</div>
					<input
						id="minimum_difference"
						type="range"
						name="minimum_difference"
						class="slider"
						min="1"
						max="200"
						step="1"
						value={ fmt.Sprint(formData.MinimumDifference) }
						x-model.number="v"
					/>
					<p class="hint">Stops the thread bunching at the rim. Must stay below half the nail count. Higher values give longer, cleaner lines and lose fine detail.</p>
					for _, err := range FieldMsgs(formData.Errors, "composition.minimum_difference") {
						<p class="msg-error">{ err }</p>
					}
				</div>
				<!-- Hoop radius -->
				<div class="field">
					<label class="label" for="physical_radius">Hoop radius</label>
					<div class="relative">
						<input
							id="physical_radius"
							type="number"
							name="physical_radius"
							value={ fmt.Sprintf("%.1f", formData.PhysicalRadius) }
							min="0.1"
							step="0.1"
							required
							class={ "input input-num pr-10 " + errClass(formData.Errors, "composition.physical_radius") }
						/>
						<span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 font-mono text-xs text-ink-faint">mm</span>
					</div>
					<p class="hint">Your real frame radius, used for G-code and thread length. 304.8 mm is a 24-inch (diameter) hoop.</p>
					for _, err := range FieldMsgs(formData.Errors, "composition.physical_radius") {
						<p class="msg-error">{ err }</p>
					}
				</div>
			</div>
		</div>
		<div class="px-[26px] pt-[26px] pb-1.5 border-t border-line">
			<div class="flex items-baseline gap-3 mb-5">
				<h3 class="text-sm font-semibold">The render</h3>
				<span class="text-[12.5px] text-ink-faint">How the solver reads your photograph</span>
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-x-7 gap-y-[22px] pb-6">
				<!-- Working resolution -->
				<div class="field">
					<label class="label" for="img_size">Working resolution</label>
					<div class="relative">
						<input
							id="img_size"
							type="number"
							name="img_size"
							value={ fmt.Sprint(formData.ImgSize) }
							min="1"
							max="5000"
							required
							class={ "input input-num pr-10 " + errClass(formData.Errors, "composition.img_size") }
						/>
						<span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 font-mono text-xs text-ink-faint">px</span>
					</div>
					<p class="hint">Internal size the image is solved at. 800 px suits most photographs; above 1 200 px the render time climbs sharply.</p>
					for _, err := range FieldMsgs(formData.Errors, "composition.img_size") {
						<p class="msg-error">{ err }</p>
					}
				</div>
				<!-- Path budget -->
				<div class="field">
					<label class="label" for="max_paths">Path budget</label>
					<div class="relative">
						<input
							id="max_paths"
							type="number"
							name="max_paths"
							value={ fmt.Sprint(formData.MaxPaths) }
							min="1"
							max="20000"
							required
							class={ "input input-num pr-14 " + errClass(formData.Errors, "composition.max_paths") }
						/>
						<span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 font-mono text-xs text-ink-faint">paths</span>
					</div>
					<p class="hint">The solver stops early when no line improves the image, so this is a ceiling rather than a target.</p>
					for _, err := range FieldMsgs(formData.Errors, "composition.max_paths") {
						<p class="msg-error">{ err }</p>
					}
				</div>
				<!-- Thread weight -->
				<div class="field" x-show="brightness[algorithm]" x-data={ "{v: " + fmt.Sprint(formData.BrightnessFactor) + "}" }>
					<label class="label" for="brightness_factor">Thread weight</label>
					<div class="flex items-baseline justify-between gap-3">
						<span class="hint">How much each line darkens the image</span>
						<span class="font-mono text-[13px] text-ink" x-text="v"></span>
					</div>
					<input
						id="brightness_factor"
						type="range"
						name="brightness_factor"
						class="slider"
						min="1"
						max="255"
						step="1"
						value={ fmt.Sprint(formData.BrightnessFactor) }
						x-model.number="v"
					/>
					<p class="hint">Raise it for bolder thread on a light photograph; lower it when dark areas turn into a solid mass.</p>
					for _, err := range FieldMsgs(formData.Errors, "composition.brightness_factor") {
						<p class="msg-error">{ err }</p>
					}
				</div>
				<!-- Contrast -->
				<div class="field">
					<label class="label" for="image_contrast">Contrast</label>
					<div class="flex items-baseline justify-between gap-3">
						<span class="hint">CLAHE on the hoop, then a light unsharp and edge mix</span>
						<span class="font-mono text-[13px] text-ink" data-contrast-readout x-text="contrast + '%'"></span>
					</div>
					<input
						id="image_contrast"
						type="range"
						name="image_contrast"
						class="slider"
						min="1"
						max="100"
						step="1"
						x-model.number="contrast"
						value={ fmt.Sprint(int(formData.ImageContrast)) }
					/>
					<p class="hint">CLAHE local contrast, applied before solving. 28% is a solid start; raise it on a flat photo, lower it if shadows crush.</p>
					for _, err := range FieldMsgs(formData.Errors, "composition.image_contrast") {
						<p class="msg-error">{ err }</p>
					}
				</div>
			</div>
		</div>
		<div class="flex items-center justify-end gap-2.5 px-[26px] py-5 border-t border-line bg-surface-sunken rounded-b-card">
			<a href={ templ.SafeURL("/dashboard/arts/" + extractArtID(art.GetName())) } class="btn">Cancel</a>
			<button type="submit" class="btn btn-primary">
				<span id="submit-spinner" class="htmx-indicator">
					@Spinner("w-4 h-4")
				</span>
				Render composition
			</button>
		</div>
	</form>
}

// CompositionStatusBadge renders a status badge for a composition
templ CompositionStatusBadge(status pb.CompositionStatus) {
	switch status {
		case pb.CompositionStatus_COMPOSITION_STATUS_PENDING:
			<span class="badge"><span class="badge-dot"></span>Pending</span>
		case pb.CompositionStatus_COMPOSITION_STATUS_PROCESSING:
			<span class="badge badge-run"><span class="badge-dot"></span>Rendering</span>
		case pb.CompositionStatus_COMPOSITION_STATUS_COMPLETE:
			<span class="badge badge-ok"><span class="badge-dot"></span>Complete</span>
		case pb.CompositionStatus_COMPOSITION_STATUS_FAILED:
			<span class="badge badge-error"><span class="badge-dot"></span>Failed</span>
		default:
			<span class="badge">Unknown</span>
	}
}
