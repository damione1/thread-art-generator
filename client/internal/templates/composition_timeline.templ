package templates

import (
	"fmt"

	"github.com/Damione1/thread-art-generator/core/pb"
)

// CompositionTimeline renders the list of compositions for an art, newest
// first, alongside the section heading.
templ CompositionTimeline(userID, artID string, compositions []*pb.Composition) {
	<div>
		<div class="flex items-baseline justify-between mb-4">
			<h2 class="text-[16px] font-semibold">Compositions</h2>
			if len(compositions) > 0 {
				<a href={ templ.SafeURL("/dashboard/arts/" + artID + "/composition/new") } class="btn btn-primary btn-sm">
					@Icon("plus", "w-4 h-4")
					New composition
				</a>
			}
		</div>
		if len(compositions) == 0 {
			<div class="card py-16 px-6 text-center">
				@Icon("file-text", "w-10 h-10 text-ink-faint mx-auto mb-4")
				<h3 class="text-[15px] font-medium mb-2">No compositions yet</h3>
				<p class="hint mb-6 max-w-xs mx-auto">Start by creating your first composition with custom parameters.</p>
				<a href={ templ.SafeURL("/dashboard/arts/" + artID + "/composition/new") } class="btn btn-primary btn-sm">Create your first composition</a>
			</div>
		} else {
			<div class="card divide-y divide-line">
				for i, composition := range compositions {
					@CompositionCard(userID, artID, composition, len(compositions)-i, i == 0)
				}
			</div>
		}
	</div>
}

// compositionParamsLine renders the mono "N nails · N paths · ..." summary
// line shown under a composition's title.
func compositionParamsLine(c *pb.Composition) string {
	return fmt.Sprintf(
		"%s · %s · %s nails · %s paths · %s px · gap %d · contrast %.0f%%",
		algorithmLabel(c.GetAlgorithm()), polarityLabel(c.GetPolarity()), humanInt(c.GetNailsQuantity()), humanInt(c.GetMaxPaths()), humanInt(c.GetImgSize()), c.GetMinimumDifference(), c.GetImageContrast(),
	)
}

// CompositionCard renders a single composition row in the timeline
templ CompositionCard(userID, artID string, composition *pb.Composition, number int, isLatest bool) {
	<div class="flex flex-col sm:flex-row sm:items-center gap-[18px] sm:gap-[22px] px-[22px] py-5" data-composition-row>
		<div class="relative w-[72px] h-[72px] rounded-full overflow-hidden bg-surface-sunken flex items-center justify-center shrink-0">
			switch composition.GetStatus() {
				case pb.CompositionStatus_COMPOSITION_STATUS_COMPLETE:
					if composition.GetPreviewUrl() != "" {
						<img src={ composition.GetPreviewUrl() } alt="" class="absolute inset-0 w-full h-full object-cover"/>
					}
					@NailRing("")
				case pb.CompositionStatus_COMPOSITION_STATUS_FAILED:
					<div class="absolute inset-0 bg-danger/[0.08] flex items-center justify-center">
						@Icon("alert-circle", "w-[22px] h-[22px] text-danger")
					</div>
				default:
					@Spinner("w-5 h-5 text-brass")
			}
		</div>
		<div class="flex-1 min-w-0">
			<div class="flex items-center gap-2.5 text-[14px] font-semibold">
				Composition { fmt.Sprintf("%02d", number) }
				if isLatest {
					<span class="font-mono text-[10px] tracking-[0.08em] uppercase text-brass border border-brass/40 rounded-full px-2 py-0.5">latest</span>
				}
			</div>
			<div class="font-mono text-[11.5px] text-ink-muted leading-[1.7] overflow-x-auto whitespace-nowrap">
				{ compositionParamsLine(composition) }
			</div>
			if composition.GetStatus() == pb.CompositionStatus_COMPOSITION_STATUS_COMPLETE {
				<div class="font-mono text-xs text-ok mt-1">
					{ fmt.Sprintf("%s lines · %s of thread", humanInt(composition.GetTotalLines()), threadMetres(composition.GetThreadLength())) }
				</div>
			}
			if composition.GetStatus() == pb.CompositionStatus_COMPOSITION_STATUS_FAILED && composition.GetErrorMessage() != "" {
				<div class="mt-2.5 px-3 py-2.5 border border-danger/30 bg-danger/[0.07] rounded-xl text-[12.5px] text-danger">
					{ composition.GetErrorMessage() }
				</div>
			}
		</div>
		<div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-3 md:ml-auto w-full sm:w-auto">
			@CompositionStatusBadge(composition.GetStatus())
			<div class="flex gap-2">
				if composition.GetStatus() == pb.CompositionStatus_COMPOSITION_STATUS_COMPLETE {
					<a href={ templ.SafeURL("/dashboard/arts/" + artID + "/composition/" + extractCompositionID(composition.GetName())) } class="btn btn-sm">Open</a>
				}
				<a href={ templ.SafeURL("/dashboard/arts/" + artID + "/composition/new?from=" + extractCompositionID(composition.GetName())) } class="btn btn-ghost btn-sm" title="Create a new composition with these settings">Duplicate</a>
				if composition.GetStatus() == pb.CompositionStatus_COMPOSITION_STATUS_FAILED {
					<button
						type="button"
						class="btn btn-danger btn-sm"
						hx-delete={ "/dashboard/arts/" + artID + "/composition/" + extractCompositionID(composition.GetName()) }
						hx-headers={ `{"X-CSRF-Token": "` + CSRFToken(ctx) + `"}` }
						hx-confirm="Delete this failed composition?"
						hx-target="closest [data-composition-row]"
						hx-swap="outerHTML"
						title="Delete this failed composition"
					>
						Delete
					</button>
				}
			</div>
		</div>
	</div>
}
