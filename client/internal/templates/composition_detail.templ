package templates

import (
	"fmt"

	"github.com/Damione1/thread-art-generator/core/pb"
	"github.com/Damione1/thread-art-generator/core/resource"
)

// CompositionDetailPage renders the composition detail page
templ CompositionDetailPage(data *PageData, art *pb.Art, composition *pb.Composition) {
	@Layout(data) {
		@Shell() {
			<div class="pt-[34px] flex items-center gap-2.5 text-[12.5px] text-ink-faint">
				<a href="/dashboard" class="hover:text-ink-muted transition-colors">Projects</a>
				<span>/</span>
				<a href={ templ.SafeURL("/dashboard/arts/" + extractArtID(art.GetName())) } class="hover:text-ink-muted transition-colors">{ art.GetTitle() }</a>
				<span>/</span>
				<span class="text-ink-muted">Composition</span>
			</div>
			<div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mt-3.5 pb-[26px] border-b border-line">
				<div>
					<h1 class="display text-[36px] leading-[1.05]">Composition</h1>
					<div class="flex flex-wrap items-center gap-3.5 mt-3.5">
						@CompositionStatusBadge(composition.GetStatus())
						<span class="font-mono text-xs text-ink-faint">{ compositionTimestampLabel(composition) }</span>
					</div>
				</div>
				<div class="flex gap-2.5">
					<a href={ templ.SafeURL("/dashboard/arts/" + extractArtID(art.GetName()) + "/composition/new?from=" + extractCompositionID(composition.GetName())) } class="btn btn-sm">Duplicate settings</a>
					if composition.GetGcodeUrl() != "" {
						<a href={ templ.SafeURL(composition.GetGcodeUrl()) } target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">Download G-code</a>
					}
				</div>
			</div>
			<div class="grid grid-cols-1 lg:grid-cols-[1fr_400px] gap-12 items-start py-[34px] pb-16">
				@CompositionPreviewPane(composition)
				@CompositionAside(composition)
			</div>
			<!-- Auto-refresh for pending/processing status -->
			if composition.GetStatus() == pb.CompositionStatus_COMPOSITION_STATUS_PENDING ||
				composition.GetStatus() == pb.CompositionStatus_COMPOSITION_STATUS_PROCESSING {
				<div data-poll-composition={ composition.GetName() }></div>
			}
		}
	}
}

// CompositionPreviewPane renders the large disc preview and its caption,
// adapted to whatever state the composition is currently in.
templ CompositionPreviewPane(composition *pb.Composition) {
	<div>
		switch composition.GetStatus() {
			case pb.CompositionStatus_COMPOSITION_STATUS_COMPLETE:
				<div class="disc max-w-[620px] mx-auto">
					if composition.GetPreviewUrl() != "" {
						<img src={ composition.GetPreviewUrl() } alt="Thread art preview"/>
					}
					@NailRing("")
				</div>
				<div class="flex items-center justify-between gap-4 mt-[18px] max-w-[620px] mx-auto">
					<p class="hint">{ fmt.Sprintf("Preview rendered at %d px. The physical piece is %.0f mm across.", composition.GetImgSize(), composition.GetPhysicalRadius()*2) }</p>
					if composition.GetPreviewUrl() != "" {
						<a href={ templ.SafeURL(composition.GetPreviewUrl()) } target="_blank" rel="noopener" class="btn btn-ghost btn-sm">Open full size</a>
					}
				</div>
			case pb.CompositionStatus_COMPOSITION_STATUS_FAILED:
				<div class="max-w-[620px] mx-auto card p-8 flex flex-col items-center text-center">
					<div class="w-20 h-20 rounded-full bg-danger/[0.08] flex items-center justify-center">
						@Icon("alert-circle", "w-7 h-7 text-danger")
					</div>
					<h2 class="text-[17px] font-semibold mt-5">This composition did not render</h2>
					<p class="hint mt-2.5 max-w-[380px]">
						if composition.GetErrorMessage() != "" {
							{ composition.GetErrorMessage() }
						} else {
							The solver stopped before it finished. The settings are listed beside this, so you can adjust them and try again.
						}
					</p>
				</div>
			default:
				<div class="max-w-[620px] mx-auto flex flex-col items-center">
					<div class="disc max-w-[380px] flex items-center justify-center">
						<svg class="absolute inset-0 w-full h-full" viewBox="0 0 1000 1000" aria-hidden="true">
							<circle cx="500" cy="500" r="492" fill="none" stroke="#26262A" stroke-width="7"></circle>
						</svg>
						@Spinner("w-6 h-6 text-brass relative")
					</div>
					<p class="text-[13px] text-ink-muted mt-6">Drawing the thread path</p>
					<p class="hint mt-2 max-w-[340px] text-center">This takes a few minutes. The page updates on its own when it is done, so you can close it.</p>
				</div>
		}
	</div>
}

// CompositionAside renders the stats, downloads and settings-used panels
// to the right of the preview.
templ CompositionAside(composition *pb.Composition) {
	<aside>
		if composition.GetStatus() == pb.CompositionStatus_COMPOSITION_STATUS_COMPLETE {
			<div class="grid grid-cols-2 gap-px bg-line border border-line rounded-2xl overflow-hidden">
				<div class="bg-surface px-5 py-[18px]">
					<div class="font-mono text-[26px] tracking-[-0.01em] tabular">{ humanInt(composition.GetTotalLines()) }</div>
					<div class="hint mt-1">lines drawn</div>
				</div>
				<div class="bg-surface px-5 py-[18px]">
					<div class="font-mono text-[26px] tracking-[-0.01em] tabular">{ threadMetres(composition.GetThreadLength()) }</div>
					<div class="hint mt-1">thread needed</div>
					if composition.GetThreadLength() > 0 {
						<div class="hint">{ spoolFraction(composition.GetThreadLength()) }</div>
					}
				</div>
				<div class="bg-surface px-5 py-[18px]">
					<div class="font-mono text-[26px] tracking-[-0.01em] tabular">{ humanInt(composition.GetNailsQuantity()) }</div>
					<div class="hint mt-1">nails on the hoop</div>
				</div>
				<div class="bg-surface px-5 py-[18px]">
					<div class="font-mono text-[26px] tracking-[-0.01em] tabular">{ fmt.Sprintf("%.1f", composition.GetPhysicalRadius()) }</div>
					<div class="hint mt-1">hoop radius, mm</div>
				</div>
			</div>
			<h3 class="text-[15px] font-semibold mt-[30px] mb-3.5">Downloads</h3>
			<div class="space-y-2.5">
				if composition.GetGcodeUrl() != "" {
					@DownloadRow("download", "G-code", composition.GetGcodeUrl(), "text-brass")
				}
				if composition.GetPathlistUrl() != "" {
					@DownloadRow("file-text", "Path list", composition.GetPathlistUrl(), "text-ink-muted")
				}
				if composition.GetPreviewUrl() != "" {
					@DownloadRow("image", "Preview image", composition.GetPreviewUrl(), "text-ink-muted")
				}
			</div>
		}
		<h3 class="text-[15px] font-semibold mt-[30px] mb-1.5">Settings used</h3>
		<div class="card px-5">
			<div class="kv"><span class="kv-k">Algorithm</span><span class="kv-v">{ algorithmLabel(composition.GetAlgorithm()) }</span></div>
			<div class="kv"><span class="kv-k">Nails</span><span class="kv-v">{ fmt.Sprint(composition.GetNailsQuantity()) }</span></div>
			<div class="kv"><span class="kv-k">Starting nail</span><span class="kv-v">{ fmt.Sprint(composition.GetStartingNail()) }</span></div>
			<div class="kv"><span class="kv-k">Minimum gap</span><span class="kv-v">{ fmt.Sprint(composition.GetMinimumDifference()) }</span></div>
			<div class="kv"><span class="kv-k">Hoop radius</span><span class="kv-v">{ fmt.Sprintf("%.1f mm", composition.GetPhysicalRadius()) }</span></div>
			<div class="kv"><span class="kv-k">Working resolution</span><span class="kv-v">{ humanInt(composition.GetImgSize()) } px</span></div>
			<div class="kv"><span class="kv-k">Path budget</span><span class="kv-v">{ humanInt(composition.GetMaxPaths()) }</span></div>
			if solverUsesBrightness(composition.GetAlgorithm()) {
				<div class="kv"><span class="kv-k">Thread weight</span><span class="kv-v">{ fmt.Sprint(composition.GetBrightnessFactor()) }</span></div>
			}
			<div class="kv"><span class="kv-k">Contrast</span><span class="kv-v">{ fmt.Sprintf("%.0f%%", composition.GetImageContrast()) }</span></div>
		</div>
	</aside>
}

// DownloadRow renders one row in the downloads list: an icon, a label and a
// download button. Only rendered by the caller when the URL is non-empty.
templ DownloadRow(icon, name, url, iconClass string) {
	<div class="flex items-center gap-3.5 px-[18px] py-[15px] border border-line rounded-2xl bg-surface">
		@Icon(icon, "w-[18px] h-[18px] shrink-0 "+iconClass)
		<div class="flex-1 min-w-0 text-[13.5px] font-medium">{ name }</div>
		<a href={ templ.SafeURL(url) } target="_blank" rel="noopener noreferrer" class="btn btn-sm">Download</a>
	</div>
}

// compositionTimestampLabel describes when the composition was created or
// rendered, in the wording the mockup uses.
func compositionTimestampLabel(c *pb.Composition) string {
	t := c.GetCreateTime().AsTime().Format("2 Jan 2006 at 15:04")
	if c.GetStatus() == pb.CompositionStatus_COMPOSITION_STATUS_COMPLETE {
		return "rendered " + t
	}
	return "created " + t
}

// Helper function to extract composition ID from resource name
func extractCompositionID(resourceName string) string {
	compositionResource, err := resource.ParseResourceName(resourceName)
	if err != nil {
		return ""
	}

	comp, ok := compositionResource.(*resource.Composition)
	if !ok {
		return ""
	}

	return comp.CompositionID
}
