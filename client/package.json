{
  "name": "thread-art-generator-frontend",
  "version": "1.0.0",
  "description": "Thread Art Generator Frontend",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "npx tailwindcss -i ./styles/input.css -o ./public/css/tailwind.css --watch",
    "build": "npm run build:css && npm run build:js",
    "build:css": "mkdir -p ./public/css && npx tailwindcss -i ./styles/input.css -o ./public/css/tailwind.css --minify",
    "build:js": "webpack --mode=development",
    "dev:js": "webpack --mode=development --watch",
    "lint": "eslint src/ --fix",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "alpinejs": "^3.14.9",
    "htmx.org": "^2.0.6",
    "material-design-icons": "^3.0.1",
    "@bufbuild/protobuf": "^2.10.0",
    "@connectrpc/connect": "^2.1.0",
    "@connectrpc/connect-web": "^2.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/alpinejs": "^3.13.10",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.31.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.3.5",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.3",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  },
  "overrides": {
    "brace-expansion": "2.1.4",
    "nanoid": "3.3.18",
    "fast-uri": "3.1.5",
    "js-yaml": "4.3.1",
    "protobufjs": "7.6.5",
    "@protobufjs/utf8": "1.1.1",
    "websocket-driver": "0.7.5",
    "serialize-javascript": "7.0.5",
    "flatted": "3.4.2",
    "picomatch": "2.3.2",
    "yaml": "2.8.3"
  }
}
