# Thread Art Generator Environment Variables

# Server Configuration
ENVIRONMENT=development
GRPC_SERVER_PORT=9090
HTTP_SERVER_PORT=9090
FRONTEND_PORT=8080
API_URL=http://api:9090
FRONTEND_URL=http://localhost:8080

# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=threadmachine

# Queue (Postgres SKIP LOCKED)
SERVICE_HMAC_SECRET=dev-service-hmac-secret-32bytes-min

# SMTP (Mailhog in Tilt: host mailhog, port 1025, no auth, UI http://localhost:8025)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=ThreadArt
SMTP_FROM_ADDRESS=noreply@threadart.local
SMTP_TLS_MODE=none

# Admin Settings
ADMIN_EMAIL=admin@example.com

# S3 / MinIO (local). Compose remaps S3_ENDPOINT to http://minio:9000 inside the network.
# Public URL the browser hits: http://localhost:9000/thread-art/{key} (path-style).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=thread-art
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/thread-art
S3_FORCE_PATH_STYLE=true
S3_USE_TLS=false

# Session cookies
COOKIE_HASH_KEY=ADefaultHashKeyFor32BytesSecureHashing
COOKIE_BLOCK_KEY=ADefaultBlockKeyShould32BytesLength
COOKIE_DOMAIN=

# Frontend Configuration
NODE_ENV=development
