# Thread Art Generator Environment Variables

# Server Configuration
ENVIRONMENT=development
GRPC_SERVER_PORT=9090
FRONTEND_URL=http://localhost:8080
API_URL=http://api:9090
# Firebase Functions Backend URL (runs on host, so uses localhost)
BACKEND_URL=http://localhost:9090
# Direct HTTP access (no TLS/proxy)

# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=threadmachine
POSTGRES_IAM_AUTH=false

# Pub/Sub Settings
PUBSUB_PROJECT_ID=demo-thread-art-generator
PUBSUB_EMULATOR_HOST=host.docker.internal:8085
PUBSUB_TOPIC_PREFIX=thread-art

# Firebase Configuration
FIREBASE_PROJECT_ID=demo-thread-art-generator
FIREBASE_WEB_API_KEY=demo-api-key
FIREBASE_AUTH_DOMAIN=demo-thread-art-generator.firebaseapp.com
FIREBASE_AUTH_EMULATOR_HOST=host.docker.internal:9099
FIREBASE_STORAGE_EMULATOR_HOST=host.docker.internal:9199
# External host for browser access (signed URLs)
FIREBASE_STORAGE_EMULATOR_EXTERNAL_HOST=localhost:9199
# Google Cloud Storage emulator host for Admin SDK compatibility (same as FIREBASE_STORAGE_EMULATOR_HOST)
STORAGE_EMULATOR_HOST=host.docker.internal:9199
FIREBASE_EMULATOR_UI_HOST=localhost:4000

# Firebase Admin SDK Configuration
# For production: Set these environment variables
# FIREBASE_ADMIN_TYPE=service_account
# FIREBASE_ADMIN_PROJECT_ID=thread-art-generator
# FIREBASE_ADMIN_PRIVATE_KEY_ID=your_private_key_id
# FIREBASE_ADMIN_PRIVATE_KEY=your_private_key
# FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxx@thread-art-generator.iam.gserviceaccount.com
# FIREBASE_ADMIN_CLIENT_ID=your_client_id
# FIREBASE_ADMIN_AUTH_URI=https://accounts.google.com/o/oauth2/auth
# FIREBASE_ADMIN_TOKEN_URI=https://oauth2.googleapis.com/token
# FIREBASE_ADMIN_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
# FIREBASE_ADMIN_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxx@thread-art-generator.iam.gserviceaccount.com

# For local development with emulator, these variables are automatically detected
GOOGLE_CLOUD_PROJECT=demo-thread-art-generator
FIRESTORE_EMULATOR_HOST=localhost:8080

# Email Settings
EMAIL_SENDER_NAME=Thread Art Generator
EMAIL_SENDER_ADDRESS=noreply@example.com
EMAIL_SENDER_PASSWORD=email-password
SENDINBLUE_API_KEY=your_sendinblue_api_key

# Admin Settings
ADMIN_EMAIL=admin@example.com

# Firebase Storage Configuration
STORAGE_PROVIDER=firebase
STORAGE_BUCKET=demo-thread-art-generator.appspot.com
STORAGE_REGION=us-central1

# Node environment for frontend
NODE_ENV=development
TOKEN_SYMMETRIC_KEY=your-token-symmetric-key

# Internal API Key for Firebase Cloud Functions authentication
# This key is used by Cloud Functions to authenticate with the internal sync endpoint
INTERNAL_API_KEY=dev-api-key-12345

# Frontend secure cookie encryption keys (32 bytes each)
# IMPORTANT: In production, use secure random keys and keep them consistent across deployments
COOKIE_HASH_KEY=32BytesSecureHashKeyForDevEnviront
COOKIE_BLOCK_KEY=32BytesSecureBlckKeyForDevEnviront
COOKIE_DOMAIN=

# PASETO Configuration for BFF → API Authentication
# IMPORTANT: In production, use a secure random 32-byte key and keep it consistent across deployments
PASETO_SECRET_KEY=32BytesSecurePasetoKeyForDevEnvir
PASETO_ISSUER=thread-art-generator
PASETO_TTL_MINUTES=15
