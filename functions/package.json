{
  "name": "thread-art-generator-functions",
  "description": "Cloud Functions for Firebase - Thread Art Generator",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "dotenv": "^16.3.1",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^4.9.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/node-fetch": "^2.6.4",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "protobufjs": "7.6.5",
    "@protobufjs/utf8": "1.1.1",
    "websocket-driver": "0.7.5",
    "fast-xml-parser": "5.7.0",
    "node-forge": "1.4.0",
    "body-parser": "1.20.6",
    "qs": "6.15.2",
    "@grpc/grpc-js": "1.13.5",
    "express": "4.22.1",
    "path-to-regexp": "0.1.13",
    "form-data": "4.0.6",
    "jws": "4.0.1",
    "@tootallnate/once": "2.0.1"
  },
  "private": true
}